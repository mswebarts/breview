<?xml version="1.0"?>
<ruleset name="Breview">
	<description>WordPress Coding Standards for the Breview plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- Scan PHP files only, show sniff codes, use colors, run in parallel. -->
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress">
		<!-- Allow short array syntax. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="breview"/>
			</property>
		</properties>
	</rule>

	<!-- The main plugin file must keep the plugin slug as its name. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/breview\.php$</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="breview"/>
				<element value="msbr"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="5.5"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
